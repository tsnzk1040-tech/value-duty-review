# Gemini（キーはリポ外。値はローカルの .env.local に置く）
GEMINI_API_KEY=
# 任意。未設定時は gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# auto（既定）| gemini | stub — auto はキーがあれば Gemini、無ければ stub
REVIEW_GENERATE_PROVIDER=auto

# Neon（レビュー履歴の正本。未設定でもコピーは可・履歴保存のみスキップ）
DATABASE_URL=

# アプリ認証は UI 設定（localStorage）で行う。環境変数パスワードは使わない。
